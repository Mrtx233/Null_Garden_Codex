---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import {
  getPostDescription,
  getPostOrderLabel,
  getPostTitle,
  getPostUrl,
  sortPostsByFileOrder
} from "../../utils/blog";

interface Props {
  post: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
}

export async function getStaticPaths() {
  const allPosts = sortPostsByFileOrder(
    await getCollection("blog", ({ data }) => !data.draft)
  );

  return allPosts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts }
  }));
}

const { post, allPosts: postsForNavigation } = Astro.props;
const allPosts = sortPostsByFileOrder(postsForNavigation);
const { Content, headings } = await render(post);
const title = getPostTitle(post);
const description = getPostDescription(post);
const tableOfContents = headings.filter(
  (heading) =>
    heading.slug &&
    heading.text !== title &&
    heading.text !== "目录" &&
    heading.depth > 1 &&
    heading.depth < 4
);
---

<BaseLayout
  title={`${title} | Null Garden | LV MA`}
  description={description}
  ogType="article"
>
  <div class="article-shell">
    <aside class="side-nav article-side-nav" aria-label="文章侧边导航">
      {tableOfContents.length > 0 && (
        <section>
          <p class="side-nav-title">本文目录</p>
          <nav>
            {tableOfContents.map((heading) => (
              <a
                class:list={[
                  "toc-link",
                  heading.depth === 3 && "toc-link-nested"
                ]}
                href={`#${heading.slug}`}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </section>
      )}

      <section>
        <p class="side-nav-title">全部文章</p>
        <nav>
          {allPosts.map((item) => (
            <a
              class:list={[item.id === post.id && "is-active"]}
              href={getPostUrl(item)}
              aria-current={item.id === post.id ? "page" : undefined}
            >
              <span>{getPostOrderLabel(item)}</span>
              {getPostTitle(item)}
            </a>
          ))}
        </nav>
      </section>
    </aside>

    <article class="article">
      <header class="article-header">
        <p class="eyebrow">Article</p>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="article-meta">
          <span>{getPostOrderLabel(post)}</span>
          {post.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="标签">
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </div>
      </header>
      <div class="content">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
