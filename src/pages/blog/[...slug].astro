---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import ReadingNavigation from "../../components/ReadingNavigation.astro";
import { readingMinutes, formatDate } from "../../utils/reading";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import {
  getPostDescription,
  getPostOrderLabel,
  getPostTitle,
  getPostUrl,
  sortPostsByFileOrder
} from "../../utils/blog";

interface Props {
  post: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
}

export async function getStaticPaths() {
  const allPosts = sortPostsByFileOrder(
    await getCollection("blog", ({ data }) => !data.draft)
  );

  return allPosts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts }
  }));
}

const { post, allPosts: postsForNavigation } = Astro.props;
const allPosts = sortPostsByFileOrder(postsForNavigation);
const { Content, headings } = await render(post);
const title = getPostTitle(post);
const description = getPostDescription(post);
const tableOfContents = headings.filter(
  (heading) =>
    heading.slug &&
    heading.text !== title &&
    heading.text !== "目录" &&
    heading.text !== "Table of Contents" &&
    heading.depth > 1 &&
    heading.depth < 4
);
const navigationItems = allPosts;
const currentIndex = navigationItems.findIndex(entry => entry.id === post.id);
const previousEntry = navigationItems[currentIndex - 1];
const nextEntry = navigationItems[currentIndex + 1];
const previous = previousEntry ? { title: getPostTitle(previousEntry), url: getPostUrl(previousEntry) } : undefined;
const next = nextEntry ? { title: getPostTitle(nextEntry), url: getPostUrl(nextEntry) } : undefined;
---

<BaseLayout
  title={`${title} | Null Garden | LV MA`}
  description={description}
  ogType="article"
>
  <div class="article-shell">
    <aside class="side-nav article-side-nav" aria-label="文章侧边导航">
      <TableOfContents headings={tableOfContents} />

      <details class="collection-navigation" data-desktop-open>
        <summary>全部文章</summary>
        <nav>
          {allPosts.map((item) => (
            <a
              class:list={[item.id === post.id && "is-active"]}
              href={getPostUrl(item)}
              aria-current={item.id === post.id ? "page" : undefined}
            >
              <span>{getPostOrderLabel(item)}</span>
              {getPostTitle(item)}
            </a>
          ))}
        </nav>
      </details>
    </aside>

    <article class="article">
      <header class="article-header">
        <p class="eyebrow">Article</p>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="article-meta">
          <span>约 {readingMinutes(post.body)} 分钟阅读</span>
          <span>{getPostOrderLabel(post)}</span>
          {post.data.pubDate && <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>}
          {post.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="标签">
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </div>
      </header>
      <div class="content">
        <Content />
      </div>
      <ReadingNavigation previous={previous} next={next} listUrl="/blog/" listLabel="全部文章" />
    </article>
  </div>
</BaseLayout>
