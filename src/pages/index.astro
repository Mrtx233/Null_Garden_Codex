---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeCardSection from "../components/HomeCardSection.astro";
import ProjectCover from "../components/ProjectCover.astro";
import PostCover from "../components/PostCover.astro";
import ManualSeriesCover from "../components/ManualSeriesCover.astro";
import { Image } from "astro:assets";
import homeGarden from "../assets/home-garden.png";
import { getCollection } from "astro:content";
import {
  getPostDescription,
  getPostOrderLabel,
  getPostTitle,
  sortPostsByLatest
} from "../utils/blog";
import {
  getManualDescription,
  getManualOrderLabel,
  getManualSeriesAnchor,
  getManualTitle,
  groupManualsBySeries
} from "../utils/developmentManual";
import {
  getProjectDescription,
  getProjectGithubLabel,
  getProjectOrderLabel,
  getProjectTitle,
  getProjectUrl,
  sortProjectsByFileOrder
} from "../utils/projects";

const allPosts = sortPostsByLatest(
  await getCollection("blog", ({ data }) => !data.draft)
);

const allProjects = sortProjectsByFileOrder(
  await getCollection("projects", ({ data }) => !data.draft)
);
const projects = [...allProjects].reverse();

const manualSeries = groupManualsBySeries(
  await getCollection("developmentManual", ({ data }) => !data.draft)
);
const manualCount = manualSeries.reduce((total, series) => total + series.entries.length, 0);
---

<BaseLayout>
  <div class="home-page">
    <section class="hero">
      <div class="hero-intro">
        <div class="hero-copy">
          <p class="eyebrow">Null Garden | LV MA</p>
          <h1>在空白处<br />种下<span>想法。</span></h1>
          <p>
            你好，我是 LV MA。这里是 Null Garden，一个记录技术、AI 工具、项目实践和个人思考的地方。
          </p>
          <div class="hero-actions" aria-label="主要操作">
            <a class="button button-primary" href="/blog/">阅读文章</a>
            <a class="button button-secondary" href="/development-manual/">开发手册</a>
            <a class="button button-secondary" href="/about/">关于我</a>
          </div>
        </div>
        <figure class="hero-visual">
          <span class="garden-orbit" aria-hidden="true"></span>
          <Image
            src={homeGarden}
            alt="戴黑框眼镜的角色在电脑前培育一棵长出代码、文章与数据的树"
            widths={[400, 640, 960]}
            sizes="(max-width: 820px) 320px, 44vw"
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption><span aria-hidden="true">✦</span> 让想法生根，让实践生长</figcaption>
        </figure>
      </div>
      <nav class="content-overview" aria-label="内容概览">
        <div class="overview-intro">
          <span class="eyebrow">Explore the Garden</span><span>这里正在生长</span>
        </div>
        <a href="/blog/">
          <strong>{allPosts.length}<span>篇文章</span></strong>
          <small>技术笔记与思考</small><span class="overview-arrow" aria-hidden="true">↗</span>
        </a>
        <a href="/development-manual/">
          <strong>{manualSeries.length}<span>个手册专栏</span></strong>
          <small>{manualCount} 篇循序渐进的实践</small><span class="overview-arrow" aria-hidden="true">↗</span>
        </a>
        <a href="/projects/">
          <strong>{allProjects.length}<span>个个人项目</span></strong>
          <small>从想法到实际应用</small><span class="overview-arrow" aria-hidden="true">↗</span>
        </a>
      </nav>
    </section>

    <HomeCardSection
      id="latest-notes"
      eyebrow="Latest Notes"
      title="全部文章"
      href="/blog/"
      linkLabel="文章目录"
    >
      {allPosts.map((post) => (
        <article class="post-card">
          <PostCover post={post} compact />
          <p class="post-date">{getPostOrderLabel(post)}</p>
          <h3>
            <a href={`/blog/${post.id}/`}>{getPostTitle(post)}</a>
          </h3>
          <p class="card-description">{getPostDescription(post)}</p>
          {post.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="标签">
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </article>
      ))}
    </HomeCardSection>

    <HomeCardSection
      id="manual-series"
      eyebrow="Development Manual"
      title="开发手册专栏"
      href="/development-manual/"
      linkLabel="查看全部手册"
    >
      {manualSeries.map((series) => {
        const firstManual = series.entries[0];
        return (
          <article class="manual-series-card">
            <ManualSeriesCover title={series.title} compact />
            <div class="post-meta">
              <span>{series.entries.length} 篇</span>
              {firstManual && <span>{getManualOrderLabel(firstManual)}</span>}
            </div>
            <h3>
              <a href={`/development-manual/#${getManualSeriesAnchor(series.title)}`}>
                {series.title}
              </a>
            </h3>
            {firstManual && <p class="card-description">{getManualDescription(firstManual)}</p>}
            <ul class="manual-mini-list" aria-label={`${series.title} 预览`}>
              {series.entries.slice(0, 3).map((manual) => (
                <li>
                  <a href={`/development-manual/${manual.id}/`}>
                    {getManualTitle(manual)}
                  </a>
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </HomeCardSection>

    <HomeCardSection
      id="recent-projects"
      eyebrow="Projects"
      title="我的项目"
      href="/projects/"
      linkLabel="项目目录"
    >
      {projects.map((project) => (
        <article class="project-card">
          <ProjectCover project={project} compact />
          <div class="post-meta">
            <span>{getProjectOrderLabel(project)}</span>
            <span>{getProjectGithubLabel(project)}</span>
          </div>
          <h3>
            <a href={getProjectUrl(project)}>{getProjectTitle(project)}</a>
          </h3>
          <p class="card-description">{getProjectDescription(project)}</p>
          {project.data.stack.length > 0 && (
            <ul class="tag-list" aria-label="技术栈">
              {project.data.stack.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </article>
      ))}
    </HomeCardSection>
  </div>
</BaseLayout>

<style>
  :global(.site-main:has(.home-page)) {
    padding-top: 0;
    padding-bottom: 0;
  }

  .hero {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 2rem;
    max-width: none;
    min-height: max(36rem, calc(100svh - 5.5rem));
    margin-bottom: 0;
    padding: 2.5rem 0 2rem;
  }
  .hero-intro {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 2rem;
  }
  .hero-copy {
    min-width: 0;
  }
  .hero h1 {
    font-size: clamp(3rem, 5.6vw, 5rem);
    line-height: 1.16;
  }
  .hero h1 span {
    color: var(--color-accent);
  }
  .hero-copy > p:not(.eyebrow) {
    max-width: 33rem;
  }
  .hero-visual {
    position: relative;
    isolation: isolate;
    margin: 0;
    text-align: center;
  }
  .hero-visual img {
    display: block;
    position: relative;
    width: 100%;
    max-width: min(28rem, calc(100svh - 21rem));
    height: auto;
    margin: auto;
  }
  .garden-orbit {
    position: absolute;
    z-index: -1;
    inset: 7% 12% 12%;
    border: 1px solid color-mix(in srgb, var(--color-accent), transparent 77%);
    border-radius: 50%;
    background: radial-gradient(ellipse, var(--color-accent-soft), transparent 68%);
    transform: rotate(-18deg);
  }
  .hero-visual figcaption {
    color: var(--color-muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }
  .hero-visual figcaption span {
    color: var(--color-accent);
    margin-right: 0.35rem;
  }
  .content-overview {
    display: grid;
    grid-template-columns: 1fr repeat(3, 1.2fr);
    align-items: center;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .overview-intro {
    display: grid;
    gap: 0.25rem;
  }
  .overview-intro .eyebrow {
    margin: 0;
    font-size: 0.72rem;
  }
  .overview-intro > span:last-child {
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .content-overview a {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 0.25rem 1.5rem;
    border-left: 1px solid var(--color-line);
    text-decoration: none;
    transition: background-color 160ms ease;
  }
  .content-overview a:hover {
    background: var(--color-accent-soft);
  }
  .content-overview strong {
    font-size: 2rem;
    font-family: var(--font-mono);
    color: var(--color-accent);
    line-height: 1.2;
  }
  .content-overview strong span {
    margin-left: 0.65rem;
    font-size: 0.9rem;
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-text);
  }
  .content-overview small {
    color: var(--color-muted);
    font-size: 0.8rem;
  }
  .overview-arrow {
    position: absolute;
    right: 0.7rem;
    top: 0.25rem;
    color: var(--color-muted);
  }
  @media (max-width: 980px) {
    .content-overview {
      grid-template-columns: repeat(3, 1fr);
    }
    .overview-intro {
      grid-column: 1 / -1;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .content-overview a:first-of-type {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (max-width: 820px) {
    .hero {
      min-height: auto;
      gap: 2rem;
      padding-top: 3rem;
    }
    .hero-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .hero-visual img {
      max-width: 20rem;
    }
    .garden-orbit {
      max-width: 22rem;
      margin: auto;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 2rem;
    }
    .hero h1 {
      font-size: 2.8rem;
    }
    .hero-actions {
      gap: 0.5rem;
      margin-top: 1.5rem;
    }
    .hero-actions .button {
      padding: 0.65rem 0.8rem;
    }
    .content-overview a {
      padding: 0.2rem 0.65rem;
    }
    .content-overview strong {
      font-size: 1.6rem;
    }
    .content-overview strong span {
      display: block;
      margin: 0.35rem 0 0;
      font-size: 0.78rem;
    }
    .content-overview small {
      font-size: 0.7rem;
      line-height: 1.6;
    }
    .overview-arrow {
      right: 0.35rem;
      font-size: 0.8rem;
    }
  }
</style>
