---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
  getProjectDescription,
  getProjectGithubLabel,
  getProjectOrderLabel,
  getProjectTitle,
  getProjectUrl,
  sortProjectsByFileOrder
} from "../../utils/projects";

const projects = sortProjectsByFileOrder(
  await getCollection("projects", ({ data }) => !data.draft)
);
---

<BaseLayout
  title="项目 | Null Garden | LV MA"
  description="LV MA 开发的个人项目，涵盖数据采集、电商自动化、全栈应用与 AI 工具。"
>
  <section class="page-header">
    <p class="eyebrow">Projects</p>
    <h1>我的项目</h1>
    <p>
      这里展示我开发的 {projects.length} 个项目，覆盖数据采集、电商自动化、全栈应用与 AI 工具，记录每个项目的设计思路、技术实现和实践经验。
    </p>
  </section>

  <div class="project-grid">
    {projects.map((project) => (
      <article class="project-card">
        <div class="post-meta">
          <span>{getProjectOrderLabel(project)}</span>
          <span>{getProjectGithubLabel(project)}</span>
        </div>
        <h2>
          <a href={getProjectUrl(project)}>{getProjectTitle(project)}</a>
        </h2>
        <p>{getProjectDescription(project)}</p>
        {project.data.stack.length > 0 && (
          <ul class="tag-list" aria-label="技术栈">
            {project.data.stack.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </article>
    ))}
  </div>
</BaseLayout>
