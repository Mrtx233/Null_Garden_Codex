---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import ReadingNavigation from "../../components/ReadingNavigation.astro";
import { readingMinutes } from "../../utils/reading";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import {
  getProjectDescription,
  getProjectGithubLabel,
  getProjectOrderLabel,
  getProjectTitle,
  getProjectUrl,
  sortProjectsByFileOrder
} from "../../utils/projects";

interface Props {
  project: CollectionEntry<"projects">;
  allProjects: CollectionEntry<"projects">[];
}

export async function getStaticPaths() {
  const allProjects = sortProjectsByFileOrder(
    await getCollection("projects", ({ data }) => !data.draft)
  );

  return allProjects.map((project) => ({
    params: { slug: project.id },
    props: { project, allProjects }
  }));
}

const { project, allProjects } = Astro.props;
const { Content, headings } = await render(project);
const title = getProjectTitle(project);
const description = getProjectDescription(project);
const tableOfContents = headings.filter(
  (heading) => heading.slug && heading.depth > 1 && heading.depth < 4
);
const navigationItems = allProjects;
const currentIndex = navigationItems.findIndex(entry => entry.id === project.id);
const previousEntry = navigationItems[currentIndex - 1];
const nextEntry = navigationItems[currentIndex + 1];
const previous = previousEntry ? { title: getProjectTitle(previousEntry), url: getProjectUrl(previousEntry) } : undefined;
const next = nextEntry ? { title: getProjectTitle(nextEntry), url: getProjectUrl(nextEntry) } : undefined;
---

<BaseLayout
  title={`${title} | Null Garden | LV MA`}
  description={description}
  ogType="article"
>
  <div class="article-shell">
    <aside class="side-nav project-side-nav" aria-label="项目侧边导航">
      <TableOfContents headings={tableOfContents} />

      <details class="collection-navigation" data-desktop-open>
        <summary>全部项目</summary>
        <nav>
          {allProjects.map((item) => (
            <a
              class:list={[item.id === project.id && "is-active"]}
              href={getProjectUrl(item)}
              aria-current={item.id === project.id ? "page" : undefined}
            >
              <span>{getProjectOrderLabel(item)}</span>
              {getProjectTitle(item)}
            </a>
          ))}
        </nav>
      </details>
    </aside>

    <article class="article">
      <header class="article-header">
        <p class="eyebrow">Project</p>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="article-meta">
          <span>约 {readingMinutes(project.body)} 分钟阅读</span>
          <span>{getProjectOrderLabel(project)}</span>
          <span>{getProjectGithubLabel(project)}</span>
          {project.data.stack.length > 0 && (
            <ul class="tag-list" aria-label="技术栈">
              {project.data.stack.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </div>
        {project.data.githubUrl?.trim() ? (
          <p class="project-link-slot">
            <a href={project.data.githubUrl} target="_blank" rel="noreferrer">
              {project.data.repositoryVisibility === "private" ? "查看 GitHub 仓库（需访问权限）" : "查看 GitHub 仓库"}
            </a>
          </p>
        ) : (
          <p class="project-link-slot">GitHub 链接待填写</p>
        )}
      </header>
      <div class="content">
        <Content />
      </div>
      <ReadingNavigation previous={previous} next={next} listUrl="/projects/" listLabel="全部项目" />
    </article>
  </div>
</BaseLayout>
