---
import "../styles/global.css";
interface Props { title?: string; description?: string; ogType?: "website" | "article"; noindex?: boolean }
const {
  title = "Null Garden | LV MA",
  description = "你好，我是 LV MA。这里是 Null Garden，一个记录技术、AI 工具、项目实践和个人思考的地方。",
  ogType = "website",
  noindex = false
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const shareImage = new URL("/share.png", Astro.site ?? Astro.url).toString();
const navigation = [ ["/", "首页"], ["/blog/", "文章"], ["/development-manual/", "手册"], ["/projects/", "项目"], ["/about/", "关于"] ];
---
<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0f14" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Null Garden — 在空白处种下想法" />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // 在正文绘制前恢复主题；禁用存储时仍可正常阅读与切换。
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body id="page-top">
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <a class="site-title" href="/">Null Garden_</a>
      <nav class="site-nav" aria-label="主导航">
        {navigation.map(([url, label]) => <a href={url} aria-current={(url === "/" ? Astro.url.pathname === url : Astro.url.pathname.startsWith(url)) ? "page" : undefined}>{label}</a>)}
      </nav>
      <button class="theme-toggle" type="button" aria-label="切换浅色模式">◐</button>
    </header>
    <main class="site-main" id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <p>Null Garden | LV MA</p>
      <nav aria-label="页脚导航"><a href="#page-top">返回顶部 ↑</a></nav>
    </footer>
    <script>
      import "../scripts/browser";
    </script>
  </body>
</html>
